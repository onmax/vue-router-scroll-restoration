{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["./**/*.ts", "./**/*.vue", "../fixtures/**/*.ts", "../fixtures/**/*.vue", "../src/runtime/index.ts", "../src/runtime/core.ts"]
}
